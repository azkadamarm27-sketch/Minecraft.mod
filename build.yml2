name: build

on:
  push:
    branches: ["**"]
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-22.04
    steps:
      - name: Tulis file proyek
        run: |
          mkdir -p src/main/java/com/darkimpus src/main/resources src/main/resources/assets/darkimpus/lang src/main/resources/assets/darkimpus/models/item src/main/resources/assets/darkimpus/textures/item
          cat > build.gradle <<'EOF_FILE'
          plugins {
              id 'fabric-loom' version '1.6-SNAPSHOT'
              id 'maven-publish'
          }

          version = project.mod_version
          group = project.maven_group

          base {
              archivesName = project.archives_base_name
          }

          repositories {
          }

          dependencies {
              minecraft "com.mojang:minecraft:${project.minecraft_version}"
              mappings "net.fabricmc:yarn:${project.yarn_mappings}:v2"
              modImplementation "net.fabricmc:fabric-loader:${project.loader_version}"
              modImplementation "net.fabricmc.fabric-api:fabric-api:${project.fabric_version}"
          }

          processResources {
              inputs.property "version", project.version

              filesMatching("fabric.mod.json") {
                  expand "version": project.version
              }
          }

          tasks.withType(JavaCompile).configureEach {
              it.options.release = 17
          }

          java {
              withSourcesJar()
              sourceCompatibility = JavaVersion.VERSION_17
              targetCompatibility = JavaVersion.VERSION_17
          }
          EOF_FILE
          cat > settings.gradle <<'EOF_FILE'
          pluginManagement {
              repositories {
                  maven {
                      name = 'Fabric'
                      url = 'https://maven.fabricmc.net/'
                  }
                  mavenCentral()
                  gradlePluginPortal()
              }
          }
          EOF_FILE
          cat > gradle.properties <<'EOF_FILE'
          org.gradle.jvmargs=-Xmx1G
          org.gradle.parallel=true

          minecraft_version=1.20.1
          yarn_mappings=1.20.1+build.10
          loader_version=0.15.11

          mod_version=1.0.0
          maven_group=com.darkimpus
          archives_base_name=darkimpus

          fabric_version=0.92.2+1.20.1
          EOF_FILE
          cat > src/main/resources/fabric.mod.json <<'EOF_FILE'
          {
            "schemaVersion": 1,
            "id": "darkimpus",
            "version": "${version}",
            "name": "Dark Impus",
            "description": "Senjata dark fantasy untuk server roleplay.",
            "authors": ["DarkImpus"],
            "environment": "*",
            "entrypoints": {
              "main": ["com.darkimpus.DarkImpusMod"]
            },
            "depends": {
              "fabricloader": ">=0.15.0",
              "minecraft": "~1.20.1",
              "java": ">=17",
              "fabric-api": "*"
            }
          }
          EOF_FILE
          cat > src/main/resources/assets/darkimpus/lang/en_us.json <<'EOF_FILE'
          {
            "item.darkimpus.dark_impus": "Dark Impus",
            "item.darkimpus.storm_hammer": "Palu Badai"
          }
          EOF_FILE
          cat > src/main/resources/assets/darkimpus/models/item/dark_impus.json <<'EOF_FILE'
          {
            "parent": "minecraft:item/handheld",
            "textures": {
              "layer0": "darkimpus:item/dark_impus"
            }
          }
          EOF_FILE
          cat > src/main/java/com/darkimpus/DarkImpusMod.java <<'EOF_FILE'
          package com.darkimpus;

          import net.fabricmc.api.ModInitializer;
          import net.fabricmc.fabric.api.item.v1.FabricItemSettings;
          import net.fabricmc.fabric.api.itemgroup.v1.ItemGroupEvents;
          import net.minecraft.item.Item;
          import net.minecraft.item.ItemGroups;
          import net.minecraft.registry.Registries;
          import net.minecraft.registry.Registry;
          import net.minecraft.util.Identifier;
          import net.minecraft.util.Rarity;

          public class DarkImpusMod implements ModInitializer {
              public static final String MOD_ID = "darkimpus";

              public static final Item DARK_IMPUS = Registry.register(
                      Registries.ITEM,
                      new Identifier(MOD_ID, "dark_impus"),
                      new DarkImpusSword(new FabricItemSettings().rarity(Rarity.EPIC).fireproof())
              );

              public static final Item STORM_HAMMER = Registry.register(
                      Registries.ITEM,
                      new Identifier(MOD_ID, "storm_hammer"),
                      new StormHammer(new FabricItemSettings().rarity(Rarity.EPIC).fireproof())
              );

              @Override
              public void onInitialize() {
                  ItemGroupEvents.modifyEntriesEvent(ItemGroups.COMBAT).register(entries -> {
                      entries.add(DARK_IMPUS);
                      entries.add(STORM_HAMMER);
                  });
                  SkillTicker.register();
              }
          }
          EOF_FILE
          cat > src/main/java/com/darkimpus/DarkImpusSword.java <<'EOF_FILE'
          package com.darkimpus;

          import java.util.List;

          import net.minecraft.client.item.TooltipContext;
          import net.minecraft.entity.LivingEntity;
          import net.minecraft.entity.effect.StatusEffectInstance;
          import net.minecraft.entity.effect.StatusEffects;
          import net.minecraft.item.ItemStack;
          import net.minecraft.item.Items;
          import net.minecraft.item.ToolMaterial;
          import net.minecraft.particle.ParticleTypes;
          import net.minecraft.recipe.Ingredient;
          import net.minecraft.server.network.ServerPlayerEntity;
          import net.minecraft.server.world.ServerWorld;
          import net.minecraft.sound.SoundCategory;
          import net.minecraft.sound.SoundEvents;
          import net.minecraft.text.Text;
          import net.minecraft.util.Formatting;
          import net.minecraft.util.math.Box;
          import net.minecraft.util.math.Vec3d;
          import net.minecraft.world.World;
          import org.jetbrains.annotations.Nullable;

          public class DarkImpusSword extends SkillWeapon {

              public DarkImpusSword(Settings settings) {
                  // damage total = 1 (tangan) + 4 (material) + 3 = 8, kecepatan serang 1.6
                  super(DarkMaterial.INSTANCE, 3, -2.4f, settings);
              }

              // ===== PENGATURAN SKILL (ubah angka di sini) =====
              @Override
              public String getSkillName(int slot) {
                  return switch (slot) {
                      case SKILL1 -> "Tebasan Bayangan";
                      case SKILL2 -> "Gelombang Kegelapan";
                      default -> "Kiamat Jiwa";
                  };
              }

              @Override
              public int getCooldownTicks(int slot) {
                  // 20 tick = 1 detik
                  return switch (slot) {
                      case SKILL1 -> 80;   // 4 detik
                      case SKILL2 -> 160;  // 8 detik
                      default -> 800;      // 40 detik
                  };
              }

              @Override
              protected void castSkill(int slot, ServerWorld world, ServerPlayerEntity player) {
                  switch (slot) {
                      case SKILL1 -> tebasanBayangan(world, player);
                      case SKILL2 -> gelombangKegelapan(world, player);
                      default -> kiamatJiwa(world, player);
                  }
              }

              // ===== KLIK KIRI: efek serangan biasa =====
              @Override
              public boolean postHit(ItemStack stack, LivingEntity target, LivingEntity attacker) {
                  if (attacker.getWorld() instanceof ServerWorld serverWorld) {
                      target.addStatusEffect(new StatusEffectInstance(StatusEffects.WITHER, 100, 1), attacker);
                      attacker.heal(1.0f); // curi nyawa
                      serverWorld.spawnParticles(ParticleTypes.SOUL,
                              target.getX(), target.getBodyY(0.5), target.getZ(),
                              12, 0.3, 0.4, 0.3, 0.02);
                  }
                  return super.postHit(stack, target, attacker);
              }

              // ===== KLIK KANAN: dash menebas ke depan =====
              private void tebasanBayangan(ServerWorld world, ServerPlayerEntity player) {
                  Vec3d look = player.getRotationVec(1.0f);
                  player.addVelocity(look.x * 1.6, 0.15, look.z * 1.6);
                  player.velocityModified = true;

                  for (LivingEntity target : nearby(world, player, 3.0)) {
                      target.damage(world.getDamageSources().playerAttack(player), 5.0f);
                      target.addStatusEffect(new StatusEffectInstance(StatusEffects.SLOWNESS, 40, 1), player);
                  }

                  world.spawnParticles(ParticleTypes.SOUL,
                          player.getX(), player.getY() + 1.0, player.getZ(),
                          25, 0.4, 0.5, 0.4, 0.05);
                  world.playSound(null, player.getBlockPos(), SoundEvents.ENTITY_PLAYER_ATTACK_SWEEP,
                          SoundCategory.PLAYERS, 1.0f, 0.7f);
              }

              // ===== TAP SHIFT: gelombang kegelapan di sekitar =====
              private void gelombangKegelapan(ServerWorld world, ServerPlayerEntity player) {
                  for (LivingEntity target : nearby(world, player, 4.0)) {
                      target.damage(world.getDamageSources().playerAttack(player), 6.0f);
                      target.addStatusEffect(new StatusEffectInstance(StatusEffects.SLOWNESS, 60, 1), player);
                      target.addStatusEffect(new StatusEffectInstance(StatusEffects.WITHER, 60, 0), player);
                  }

                  world.spawnParticles(ParticleTypes.SCULK_SOUL,
                          player.getX(), player.getY() + 1.0, player.getZ(),
                          40, 1.5, 0.5, 1.5, 0.05);
                  world.playSound(null, player.getBlockPos(), SoundEvents.ENTITY_WITHER_SHOOT,
                          SoundCategory.PLAYERS, 1.0f, 0.8f);
              }

              // ===== SHIFT + KLIK KANAN: ULTI =====
              private void kiamatJiwa(ServerWorld world, ServerPlayerEntity player) {
                  for (LivingEntity target : nearby(world, player, 7.0)) {
                      target.damage(world.getDamageSources().playerAttack(player), 14.0f);
                      target.addStatusEffect(new StatusEffectInstance(StatusEffects.WITHER, 100, 2), player);
                      target.addStatusEffect(new StatusEffectInstance(StatusEffects.SLOWNESS, 100, 2), player);
                  }
                  player.heal(6.0f);

                  world.spawnParticles(ParticleTypes.SOUL_FIRE_FLAME,
                          player.getX(), player.getY() + 1.0, player.getZ(),
                          120, 3.0, 1.0, 3.0, 0.1);
                  world.spawnParticles(ParticleTypes.SCULK_SOUL,
                          player.getX(), player.getY() + 1.0, player.getZ(),
                          80, 3.0, 1.0, 3.0, 0.05);
                  world.playSound(null, player.getBlockPos(), SoundEvents.ENTITY_WITHER_SPAWN,
                          SoundCategory.PLAYERS, 0.6f, 1.2f);
              }

              private static List<LivingEntity> nearby(ServerWorld world, ServerPlayerEntity player, double radius) {
                  Box area = player.getBoundingBox().expand(radius);
                  return world.getEntitiesByClass(LivingEntity.class, area, e -> e != player && e.isAlive());
              }

              @Override
              public void appendTooltip(ItemStack stack, @Nullable World world, List<Text> tooltip, TooltipContext context) {
                  tooltip.add(Text.literal("Klik kiri: Kutukan Wither + curi nyawa").formatted(Formatting.DARK_PURPLE));
                  tooltip.add(Text.literal("Klik kanan: Tebasan Bayangan (4 dtk)").formatted(Formatting.GRAY));
                  tooltip.add(Text.literal("Tap Shift: Gelombang Kegelapan (8 dtk)").formatted(Formatting.GRAY));
                  tooltip.add(Text.literal("Shift + klik kanan: Kiamat Jiwa (40 dtk)").formatted(Formatting.RED));
              }

              public enum DarkMaterial implements ToolMaterial {
                  INSTANCE;

                  @Override
                  public int getDurability() {
                      return 1800;
                  }

                  @Override
                  public float getMiningSpeedMultiplier() {
                      return 8.0f;
                  }

                  @Override
                  public float getAttackDamage() {
                      return 4.0f;
                  }

                  @Override
                  public int getMiningLevel() {
                      return 4;
                  }

                  @Override
                  public int getEnchantability() {
                      return 20;
                  }

                  @Override
                  public Ingredient getRepairIngredient() {
                      return Ingredient.ofItems(Items.NETHERITE_INGOT);
                  }
              }
          }
          EOF_FILE
          cat > src/main/java/com/darkimpus/SkillWeapon.java <<'EOF_FILE'
          package com.darkimpus;

          import java.util.HashMap;
          import java.util.Map;
          import java.util.UUID;

          import net.minecraft.entity.player.PlayerEntity;
          import net.minecraft.item.ItemStack;
          import net.minecraft.item.SwordItem;
          import net.minecraft.item.ToolMaterial;
          import net.minecraft.server.network.ServerPlayerEntity;
          import net.minecraft.server.world.ServerWorld;
          import net.minecraft.text.Text;
          import net.minecraft.util.Formatting;
          import net.minecraft.util.Hand;
          import net.minecraft.util.TypedActionResult;
          import net.minecraft.world.World;

          /**
           * Kerangka senjata dengan sistem skill:
           * klik kiri = serangan biasa, klik kanan = skill 1,
           * tap Shift = skill 2, Shift + klik kanan = ULTI.
           * Senjata baru cukup extends class ini dan mengisi 3 method abstract.
           */
          public abstract class SkillWeapon extends SwordItem {
              public static final int SKILL1 = 0;
              public static final int SKILL2 = 1;
              public static final int ULTI = 2;

              // kapan tiap skill siap dipakai lagi (dalam tick dunia), per pemain
              // kuncinya pemain + jenis senjata, jadi tiap senjata punya cooldown sendiri
              private static final Map<String, long[]> READY_AT = new HashMap<>();

              public SkillWeapon(ToolMaterial material, int attackDamage, float attackSpeed, Settings settings) {
                  super(material, attackDamage, attackSpeed, settings);
              }

              public abstract String getSkillName(int slot);

              public abstract int getCooldownTicks(int slot);

              protected abstract void castSkill(int slot, ServerWorld world, ServerPlayerEntity player);

              public boolean tryCast(int slot, ServerWorld world, ServerPlayerEntity player) {
                  long now = world.getTime();
                  long[] ready = READY_AT.computeIfAbsent(player.getUuid() + ":" + getTranslationKey(), k -> new long[3]);

                  if (now < ready[slot]) {
                      double sisa = (ready[slot] - now) / 20.0;
                      player.sendMessage(Text.literal(getSkillName(slot) + " siap dalam "
                              + String.format("%.1f", sisa) + " detik").formatted(Formatting.GRAY), true);
                      return false;
                  }

                  ready[slot] = now + getCooldownTicks(slot);
                  castSkill(slot, world, player);
                  player.sendMessage(Text.literal(getSkillName(slot) + "!").formatted(Formatting.DARK_PURPLE), true);
                  return true;
              }

              // klik kanan = skill 1, Shift + klik kanan = ULTI
              @Override
              public TypedActionResult<ItemStack> use(World world, PlayerEntity user, Hand hand) {
                  ItemStack stack = user.getStackInHand(hand);

                  if (world instanceof ServerWorld serverWorld && user instanceof ServerPlayerEntity player) {
                      if (player.isSneaking()) {
                          SkillTicker.markUsedWhileSneaking(player);
                          tryCast(ULTI, serverWorld, player);
                      } else {
                          tryCast(SKILL1, serverWorld, player);
                      }
                  }

                  return TypedActionResult.success(stack, world.isClient());
              }
          }
          EOF_FILE
          cat > src/main/java/com/darkimpus/SkillTicker.java <<'EOF_FILE'
          package com.darkimpus;

          import java.util.HashMap;
          import java.util.HashSet;
          import java.util.Map;
          import java.util.Set;
          import java.util.UUID;

          import net.fabricmc.fabric.api.event.lifecycle.v1.ServerTickEvents;
          import net.minecraft.server.network.ServerPlayerEntity;
          import net.minecraft.server.world.ServerWorld;

          /**
           * Mendeteksi "tap Shift" (tekan lalu lepas cepat) untuk skill 2.
           * Kalau Shift ditahan lalu klik kanan (ULTI), skill 2 tidak ikut keluar.
           */
          public class SkillTicker {
              private static final int MAX_TAP_TICKS = 8; // 8 tick = 0,4 detik

              private static final Map<UUID, Long> SNEAK_START = new HashMap<>();
              private static final Set<UUID> USED_WHILE_SNEAKING = new HashSet<>();

              public static void markUsedWhileSneaking(ServerPlayerEntity player) {
                  USED_WHILE_SNEAKING.add(player.getUuid());
              }

              public static void register() {
                  ServerTickEvents.END_SERVER_TICK.register(server -> {
                      for (ServerPlayerEntity player : server.getPlayerManager().getPlayerList()) {
                          UUID id = player.getUuid();
                          boolean sneaking = player.isSneaking();
                          Long start = SNEAK_START.get(id);
                          long now = player.getWorld().getTime();

                          if (sneaking && start == null) {
                              SNEAK_START.put(id, now);
                              USED_WHILE_SNEAKING.remove(id);
                          } else if (!sneaking && start != null) {
                              SNEAK_START.remove(id);
                              boolean used = USED_WHILE_SNEAKING.remove(id);

                              if (!used
                                      && now - start <= MAX_TAP_TICKS
                                      && player.getMainHandStack().getItem() instanceof SkillWeapon weapon
                                      && player.getWorld() instanceof ServerWorld serverWorld) {
                                  weapon.tryCast(SkillWeapon.SKILL2, serverWorld, player);
                              }
                          }
                      }
                  });
              }
          }
          EOF_FILE
          cat > src/main/java/com/darkimpus/StormHammer.java <<'EOF_FILE'
          package com.darkimpus;

          import java.util.Comparator;
          import java.util.List;

          import net.minecraft.client.item.TooltipContext;
          import net.minecraft.entity.EntityType;
          import net.minecraft.entity.LightningEntity;
          import net.minecraft.entity.LivingEntity;
          import net.minecraft.entity.effect.StatusEffectInstance;
          import net.minecraft.entity.effect.StatusEffects;
          import net.minecraft.item.ItemStack;
          import net.minecraft.item.Items;
          import net.minecraft.item.ToolMaterial;
          import net.minecraft.particle.ParticleTypes;
          import net.minecraft.recipe.Ingredient;
          import net.minecraft.server.network.ServerPlayerEntity;
          import net.minecraft.server.world.ServerWorld;
          import net.minecraft.sound.SoundCategory;
          import net.minecraft.sound.SoundEvents;
          import net.minecraft.text.Text;
          import net.minecraft.util.Formatting;
          import net.minecraft.util.math.Box;
          import net.minecraft.util.math.Vec3d;
          import net.minecraft.world.World;
          import org.jetbrains.annotations.Nullable;

          public class StormHammer extends SkillWeapon {

              public StormHammer(Settings settings) {
                  // damage total = 1 + 5 + 4 = 10, serangan lambat (palu berat)
                  super(StormMaterial.INSTANCE, 4, -3.0f, settings);
              }

              // ===== PENGATURAN SKILL (ubah angka di sini) =====
              @Override
              public String getSkillName(int slot) {
                  return switch (slot) {
                      case SKILL1 -> "Terjangan Petir";
                      case SKILL2 -> "Raja Guntur";
                      default -> "Murka Langit";
                  };
              }

              @Override
              public int getCooldownTicks(int slot) {
                  // 20 tick = 1 detik
                  return switch (slot) {
                      case SKILL1 -> 100;  // 5 detik
                      case SKILL2 -> 500;  // 25 detik
                      default -> 900;      // 45 detik
                  };
              }

              @Override
              protected void castSkill(int slot, ServerWorld world, ServerPlayerEntity player) {
                  switch (slot) {
                      case SKILL1 -> terjanganPetir(world, player);
                      case SKILL2 -> rajaGuntur(world, player);
                      default -> murkaLangit(world, player);
                  }
              }

              // ===== KLIK KIRI: hantaman guntur + passive 20% stun =====
              @Override
              public boolean postHit(ItemStack stack, LivingEntity target, LivingEntity attacker) {
                  if (attacker.getWorld() instanceof ServerWorld world && attacker instanceof ServerPlayerEntity player) {
                      // petir kosmetik + percikan listrik di target
                      bolt(world, target.getX(), target.getY(), target.getZ());
                      world.spawnParticles(ParticleTypes.ELECTRIC_SPARK,
                              target.getX(), target.getBodyY(0.5), target.getZ(),
                              30, 0.4, 0.5, 0.4, 0.3);

                      // gelombang kejut kecil: musuh di sekitar target ikut kena
                      Box area = target.getBoundingBox().expand(2.5);
                      for (LivingEntity e : world.getEntitiesByClass(LivingEntity.class, area,
                              x -> x != player && x != target && x.isAlive())) {
                          e.damage(world.getDamageSources().playerAttack(player), 4.0f);
                      }

                      // passive: 20% kemungkinan stun
                      if (world.random.nextFloat() < 0.20f) {
                          stun(target, 40, player);
                          world.spawnParticles(ParticleTypes.ELECTRIC_SPARK,
                                  target.getX(), target.getY() + target.getHeight() + 0.3, target.getZ(),
                                  20, 0.3, 0.2, 0.3, 0.1);
                          player.sendMessage(Text.literal("Stun!").formatted(Formatting.AQUA), true);
                      }
                  }
                  return super.postHit(stack, target, attacker);
              }

              // ===== KLIK KANAN: dash berpetir =====
              private void terjanganPetir(ServerWorld world, ServerPlayerEntity player) {
                  Vec3d look = player.getRotationVec(1.0f);
                  bolt(world, player.getX(), player.getY(), player.getZ());

                  player.addVelocity(look.x * 1.8, 0.2, look.z * 1.8);
                  player.velocityModified = true;

                  for (LivingEntity target : nearby(world, player, 3.5)) {
                      target.damage(world.getDamageSources().playerAttack(player), 7.0f);
                      stun(target, 20, player);
                      bolt(world, target.getX(), target.getY(), target.getZ());
                  }

                  world.spawnParticles(ParticleTypes.ELECTRIC_SPARK,
                          player.getX(), player.getY() + 1.0, player.getZ(),
                          60, 0.6, 0.8, 0.6, 0.4);
                  world.playSound(null, player.getBlockPos(), SoundEvents.ITEM_TRIDENT_THUNDER,
                          SoundCategory.PLAYERS, 1.0f, 1.2f);
              }

              // ===== TAP SHIFT: mode Raja Guntur (buff 10 detik) =====
              private void rajaGuntur(ServerWorld world, ServerPlayerEntity player) {
                  player.addStatusEffect(new StatusEffectInstance(StatusEffects.SPEED, 200, 1));
                  player.addStatusEffect(new StatusEffectInstance(StatusEffects.STRENGTH, 200, 1));
                  player.addStatusEffect(new StatusEffectInstance(StatusEffects.RESISTANCE, 200, 0));
                  player.addStatusEffect(new StatusEffectInstance(StatusEffects.GLOWING, 200, 0));

                  bolt(world, player.getX(), player.getY(), player.getZ());
                  world.spawnParticles(ParticleTypes.ELECTRIC_SPARK,
                          player.getX(), player.getY() + 1.0, player.getZ(),
                          100, 0.8, 1.0, 0.8, 0.5);
                  world.playSound(null, player.getBlockPos(), SoundEvents.ENTITY_LIGHTNING_BOLT_THUNDER,
                          SoundCategory.PLAYERS, 1.0f, 1.0f);
              }

              // ===== SHIFT + KLIK KANAN: ULTI, petir menyambar banyak musuh =====
              private void murkaLangit(ServerWorld world, ServerPlayerEntity player) {
                  List<LivingEntity> targets = nearby(world, player, 12.0);
                  targets.sort(Comparator.comparingDouble(e -> e.squaredDistanceTo(player)));

                  int count = 0;
                  for (LivingEntity target : targets) {
                      if (count >= 8) break; // maksimal 8 musuh
                      bolt(world, target.getX(), target.getY(), target.getZ());
                      target.damage(world.getDamageSources().playerAttack(player), 16.0f);
                      stun(target, 60, player);
                      world.spawnParticles(ParticleTypes.ELECTRIC_SPARK,
                              target.getX(), target.getBodyY(0.5), target.getZ(),
                              50, 0.5, 0.8, 0.5, 0.4);
                      count++;
                  }

                  // cincin petir di sekeliling pemain
                  for (int i = 0; i < 6; i++) {
                      double angle = Math.PI * 2 * i / 6;
                      bolt(world, player.getX() + Math.cos(angle) * 5, player.getY(), player.getZ() + Math.sin(angle) * 5);
                  }
                  world.playSound(null, player.getBlockPos(), SoundEvents.ENTITY_LIGHTNING_BOLT_THUNDER,
                          SoundCategory.PLAYERS, 2.0f, 0.8f);
              }

              // ===== ALAT BANTU =====
              private static void bolt(ServerWorld world, double x, double y, double z) {
                  LightningEntity lightning = EntityType.LIGHTNING_BOLT.create(world);
                  if (lightning != null) {
                      lightning.refreshPositionAfterTeleport(x, y, z);
                      lightning.setCosmetic(true); // tanpa api dan tanpa damage bawaan
                      world.spawnEntity(lightning);
                  }
              }

              private static void stun(LivingEntity target, int ticks, ServerPlayerEntity source) {
                  target.addStatusEffect(new StatusEffectInstance(StatusEffects.SLOWNESS, ticks, 6), source);
                  target.addStatusEffect(new StatusEffectInstance(StatusEffects.WEAKNESS, ticks, 2), source);
              }

              private static List<LivingEntity> nearby(ServerWorld world, ServerPlayerEntity player, double radius) {
                  Box area = player.getBoundingBox().expand(radius);
                  return world.getEntitiesByClass(LivingEntity.class, area, e -> e != player && e.isAlive());
              }

              @Override
              public void appendTooltip(ItemStack stack, @Nullable World world, List<Text> tooltip, TooltipContext context) {
                  tooltip.add(Text.literal("Pasif: 20% stun saat memukul").formatted(Formatting.AQUA));
                  tooltip.add(Text.literal("Klik kiri: Hantaman Guntur").formatted(Formatting.GRAY));
                  tooltip.add(Text.literal("Klik kanan: Terjangan Petir (5 dtk)").formatted(Formatting.GRAY));
                  tooltip.add(Text.literal("Tap Shift: Raja Guntur (25 dtk)").formatted(Formatting.GRAY));
                  tooltip.add(Text.literal("Shift + klik kanan: Murka Langit (45 dtk)").formatted(Formatting.RED));
              }

              public enum StormMaterial implements ToolMaterial {
                  INSTANCE;

                  @Override
                  public int getDurability() {
                      return 2000;
                  }

                  @Override
                  public float getMiningSpeedMultiplier() {
                      return 8.0f;
                  }

                  @Override
                  public float getAttackDamage() {
                      return 5.0f;
                  }

                  @Override
                  public int getMiningLevel() {
                      return 4;
                  }

                  @Override
                  public int getEnchantability() {
                      return 18;
                  }

                  @Override
                  public Ingredient getRepairIngredient() {
                      return Ingredient.ofItems(Items.NETHERITE_INGOT);
                  }
              }
          }
          EOF_FILE
          cat > src/main/resources/assets/darkimpus/models/item/storm_hammer.json <<'EOF_FILE'
          {
            "parent": "minecraft:item/handheld",
            "textures": {
              "layer0": "darkimpus:item/storm_hammer"
            }
          }
          EOF_FILE
          base64 -d > src/main/resources/assets/darkimpus/textures/item/dark_impus.png <<'EOF_FILE'
          iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAYAAAAf8/9hAAAASklEQVR4nGNgoABMy7vzn2yNbsoVlGlW5rch3YBRzbTWvG+aEVwh2TbDDCHb2eguIRnoyoj9J9sQmGayXIKumSRQIadBvmYGBgYAFmZOvMOkv9cAAAAASUVORK5CYII=
          EOF_FILE
          base64 -d > src/main/resources/assets/darkimpus/textures/item/storm_hammer.png <<'EOF_FILE'
          iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAYAAAAf8/9hAAAAVUlEQVR4nGNgoAVYumrnf0LYxs77P14DKmp7wDjg9X+sbJIMePYf0xCiDcBmCMkGoDufKANACghhnAbAQJ6bxn83LUnCCkc1U0FzwIln5GmkWDM1AACswLSDoVlhRQAAAABJRU5ErkJggg==
          EOF_FILE

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - uses: gradle/actions/setup-gradle@v3
        with:
          gradle-version: "8.8"
      - name: Build
        run: gradle build
      - uses: actions/upload-artifact@v4
        with:
          name: darkimpus-mod
          path: build/libs/darkimpus-1.0.0.jar
      - name: Buat release
        env:
          GH_TOKEN: ${{ github.token }}
        run: gh release create "v1.0.${{ github.run_number }}" build/libs/darkimpus-1.0.0.jar --repo "${{ github.repository }}" --target "${{ github.sha }}" --title "Dark Impus build ${{ github.run_number }}" --notes "Mod Dark Impus untuk Fabric 1.20.1"
